# Slack app with Socket Mode on. xoxb- bot token, xapp- app-level token (connections:write).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs and user IDs the bot answers. ALLOWED_USERS=* allows
# everyone in those channels; empty allows nobody.
ALLOWED_CHANNELS=
ALLOWED_USERS=
# Optional overrides.
# STEER=owner   only the session's starter steers (default: anyone allowed in the channel)
# NATIVE_STREAM=0   use the edited status line instead of Slack's native streaming
# STATUS_EMOJI=:agent-working:   an animated custom emoji for the live status line
# MCP_CONNECTORS=jira,github   read-only MCP connectors for every session (unset or empty: none)
# FXA_CTL=/path/to/fxa-sandbox-ctl
# FXA_AGENT_STATE=~/.fxa-agent-sessions.json
